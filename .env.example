# Copy to .env and fill in. Never commit .env.

# --- App
ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- FalkorDB Cloud (paste from your dashboard)
FALKORDB_HOST=
FALKORDB_PORT=6379
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=
FALKORDB_SSL=true
FALKORDB_GRAPH=echo_software
FALKORDB_QUERY_TIMEOUT_MS=30000

# --- Simulation limits
MAX_CONCURRENT_FORKS=5
FORK_TTL_MINUTES=30

# --- AI (Google AI Studio free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
